#include <nx/build_info.h>

namespace nx::build_info {

QString developerBuildSuffix()
{
    return "${developer_build_suffix}";
}

QString revision()
{
    return "${changeSet}";
}

QString vmsVersion()
{
    return "${releaseVersion.full}";
}

int buildNumber()
{
    return ${buildNumber};
}

QString applicationPlatform()
{
    return "${platform}";
}

bool isArm()
{
    #if defined(__arm__) || defined(__aarch64__)
        return true;
    #else
        return false;
    #endif
}

bool isWindows()
{
    return applicationPlatform().startsWith("win");
}

bool isMacOsX()
{
    return applicationPlatform().startsWith("mac");
}

} // namespace nx::build_info
