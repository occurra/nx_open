#include <nx/branding.h>

namespace nx::branding {

QString company()
{
    return R"(${customization.companyName})";
}

QString companyId()
{
    return R"(${customization.companyId})";
}

QString defaultLocale()
{
    return R"(${customization.defaultLanguage})";
}

} // namespace nx::branding
