function(detect_target)
    if(targetDevice STREQUAL "linux_arm64")
        set(LINUX TRUE PARENT_SCOPE)
        set(detected_arch "arm64")
        set(detected_platform "linux_arm64")
    elseif(NOT targetDevice OR targetDevice MATCHES "linux|macos|windows")
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set(LINUX TRUE PARENT_SCOPE)
            if(CMAKE_SYSTEM_PROCESSOR STREQUAL "x86_64")
                set(detected_arch "x64")
            elseif(CMAKE_SYSTEM_PROCESSOR MATCHES ".*86")
                set(detected_arch "x86")
            else()
                message(FATAL_ERROR
                    "Cannot detect your system architecture ${CMAKE_SYSTEM_PROCESSOR}")
            endif()
            set(detected_platform "linux_${detected_arch}")
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Windows")
            set(WINDOWS TRUE PARENT_SCOPE)
            if(MSVC)
                if(CMAKE_CL_64)
                    set(detected_arch "x64")
                else()
                    set(detected_arch "x86")
                endif()
            else()
                if(CMAKE_SYSTEM_PROCESSOR STREQUAL "AMD64")
                    set(detected_arch "x64")
                elseif(CMAKE_SYSTEM_PROCESSOR STREQUAL ".*86")
                    set(detected_arch "x86")
                else()
                    message(FATAL_ERROR
                        "Cannot detect your system architecture ${CMAKE_SYSTEM_PROCESSOR}")
                endif()
            endif()
            set(detected_platform "windows_${detected_arch}")
        elseif(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
            set(MACOSX TRUE PARENT_SCOPE)
            if(targetDevice STREQUAL "macos_arm64")
                set(detected_arch "arm64")
                set(detected_platform "macos_arm64")
                set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE INTERNAL "")
            else()
                set(detected_arch "x64")
                set(detected_platform "macos_x64")
                set(CMAKE_OSX_ARCHITECTURES "x86_64" CACHE INTERNAL "")
            endif()
        else()
            message(FATAL_ERROR
                "Cannot detect parameters for your system ${CMAKE_SYSTEM_NAME}")
        endif()
    else()
        message(FATAL_ERROR "Unsupported targetDevice ${targetDevice}")
    endif()

    set(arch ${detected_arch} CACHE INTERNAL "")
    set(platform ${detected_platform} CACHE INTERNAL "")
endfunction()

detect_target()
